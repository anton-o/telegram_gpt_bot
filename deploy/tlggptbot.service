[Unit]
Description=Telegram GPT bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/python
ExecStart=/root/python/.venv/bin/python /root/python/main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
Environment=PYTHONUNBUFFERED=1
UMask=0077

[Install]
WantedBy=multi-user.target
